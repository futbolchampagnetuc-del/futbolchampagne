# ============================================
# FutbolChampagne — Variables de Entorno
# ============================================
# Copia este archivo como .env.local y completa los valores
# NUNCA comitear .env.local

# Supabase — Obtener en: https://supabase.com/dashboard/project/[ID]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON_KEY_PUBLICA]

# Service Role Key — SOLO para Edge Functions / scripts admin
# ⚠️ NUNCA usar en frontend. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# URL del sitio (cambiar en producción)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
